{
  "info": {
    "_postman_id": "pulsechat-api-v1",
    "name": "PulseChat Platform API Collection",
    "description": "Complete testable Postman Collection for the PulseChat real-time messaging platform. Includes pre-configured environment variables and authentication test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://frontend-task-chatapp.onrender.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login / Auto-Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Saved token:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+15551234567\",\n  \"name\": \"Ada Lovelace\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users Directory",
      "item": [
        {
          "name": "Search Users",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/search?q=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "search"],
              "query": [
                {
                  "key": "q",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Conversations",
      "item": [
        {
          "name": "List User Conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var list = Array.isArray(jsonData) ? jsonData : jsonData.data;",
                  "if (list && list.length > 0) {",
                  "    pm.collectionVariables.set('conversationId', list[0]._id);",
                  "    console.log('Saved conversationId:', list[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations"]
            }
          }
        },
        {
          "name": "Start Direct Conversation",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{targetUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations"]
            }
          }
        },
        {
          "name": "Create Group Channel (>= 3 Members)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering Core Team\",\n  \"participantIds\": [\n    \"6a8883d9e5d6aac97523781a\",\n    \"6a8883d9e5d6aac97523781b\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/group",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "group"]
            }
          }
        },
        {
          "name": "Rename Group Channel",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Design Systems Room\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}"]
            }
          }
        },
        {
          "name": "Promote Group Admin",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{targetUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/admins",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}", "admins"]
            }
          }
        },
        {
          "name": "Add Participants to Group",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userIds\": [\"{{targetUserId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/participants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}", "participants"]
            }
          }
        },
        {
          "name": "Remove Participant / Leave Group",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/participants/{{targetUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}", "participants", "{{targetUserId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Messages",
      "item": [
        {
          "name": "Get Conversation Messages (Pagination)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages?limit=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}", "messages"],
              "query": [
                {
                  "key": "limit",
                  "value": "30"
                }
              ]
            }
          }
        },
        {
          "name": "Send Message",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"text\": \"Hello from API test!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        }
      ]
    }
  ]
}
